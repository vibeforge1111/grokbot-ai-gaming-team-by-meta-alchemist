{
  "$schema": "../../spec/template.schema.json",
  "kitVersion": 1,
  "id": "gbf-18-bug-desk-triage",
  "slug": "18-bug-desk-triage",
  "name": "Playtest Bug Desk & Repro Triage Director",
  "shortName": "Bug Desk",
  "version": "1.0.1",
  "status": "shipping",
  "summary": "Turn playtest observations into reproducible local issue drafts, group duplicate reports and verify fixes against the affected build.",
  "stage": "Playtest, Live",
  "credit": "@meta_alchemist",
  "creditUrl": "https://x.com/meta_alchemist",
  "install": {
    "grokBotShareLink": "pending review",
    "shareLinkStatus": "pending review"
  },
  "gettingStarted": "bug-desk-triage-getting-started",
  "skills": [
    "bug-desk-triage-getting-started",
    "duplicate-report-grouping",
    "minimal-repro-builder",
    "severity-and-regression-bisect",
    "issue-draft-and-fix-verification",
    "bug-desk-triage-lens-engine"
  ],
  "routines": [
    "bug-desk-weekly-grade"
  ],
  "rubric": {
    "path": "RUBRIC.json",
    "id": "gbf-18-bug-desk-triage",
    "version": "1.3.0",
    "hash": "sha256:4b7bc60d6d1dbf94576da56859448d8e1a8c9f04a6811fc76b61b3ceccddb276"
  },
  "engine": {
    "cmd": "node engine/lens.mjs",
    "goodPack": "fixtures/good-pack.json"
  },
  "evidence": {
    "legacyGrade": 86,
    "externalReviewMin": 4,
    "externalReadiness": "after-fixes"
  },
  "handoffs": {
    "takesFrom": "Manual or CI playtests, accessibility reviews and service logs where applicable.",
    "handsTo": "The owner, who reviews local drafts, sets priority and updates the tracker."
  },
  "teamSpec": "1.0.0",
  "compat": {
    "teamSpec": "^1.0.0",
    "consumes": {
      "game-profile": "^1.0.0",
      "evidence-pack": "^1.0.0",
      "tracker-export": "^1.0.0",
      "ticket-draft": "^1.0.0",
      "incident-report": "^1.0.0",
      "support-case-draft": "^1.0.0"
    }
  },
  "produces": [
    {
      "artifact": "ticket-draft",
      "version": "1.0.0",
      "format": "JSON or Markdown local draft",
      "schema": "spec/artifacts/ticket-draft.schema.json"
    },
    {
      "artifact": "change-list",
      "version": "1.0.0",
      "format": "JSON (closures verified on the fixed build)",
      "schema": "spec/artifacts/change-list.schema.json"
    },
    {
      "artifact": "grade-record",
      "version": "1.0.0",
      "format": "JSON (the engine's grade record)",
      "schema": "spec/artifacts/grade-record.schema.json"
    }
  ],
  "consumes": [
    {
      "artifact": "game-profile",
      "required": true,
      "schema": "spec/artifacts/game-profile.schema.json"
    },
    {
      "artifact": "evidence-pack",
      "required": true,
      "schema": "spec/artifacts/evidence-pack.schema.json"
    },
    {
      "artifact": "tracker-export",
      "required": false,
      "schema": "spec/artifacts/tracker-export.schema.json",
      "whenMissing": "Continue: intake and closure receipts are NOT_RUN and their lines stay unmeasured; write \"ASSUMPTION: no tracker-export available\" in the report and ask the owner for a read-only export."
    },
    {
      "artifact": "ticket-draft",
      "required": false,
      "schema": "spec/artifacts/ticket-draft.schema.json",
      "whenMissing": "Continue: group only crash and player reports, and say cross-template grouping was not measured."
    },
    {
      "artifact": "incident-report",
      "required": false,
      "schema": "spec/artifacts/incident-report.schema.json"
    },
    {
      "artifact": "support-case-draft",
      "required": false,
      "schema": "spec/artifacts/support-case-draft.schema.json"
    }
  ],
  "memory": {
    "reads": [
      "decisions",
      "incidents",
      "releases"
    ],
    "writes": [
      "decisions",
      "releases"
    ]
  }
}
