      "store-asset-manifest": "^1.0.0",
      "fairness-findings": "^1.0.0",
      "work-plan": "^1.0.0"
    }
  },
  "produces": [
    {
      "artifact": "patch-notes-draft",
      "version": "1.0.0",
      "format": "Markdown draft plus a JSON map from each line to its change",
      "schema": "spec/artifacts/patch-notes-draft.schema.json"
    },
    {
      "artifact": "creator-shortlist",
      "version": "1.0.0",
      "format": "JSON with outreach drafts",
      "schema": "spec/artifacts/creator-shortlist.schema.json"
    },
    {
      "artifact": "grade-record",
      "version": "1.0.0",
      "format": "JSON (the engine's grade record)",
      "schema": "spec/artifacts/grade-record.schema.json"
    },
    {
      "artifact": "ticket-draft",
      "version": "1.0.0",
      "format": "JSON or Markdown local draft",
      "schema": "spec/artifacts/ticket-draft.schema.json"
    }
  ],
  "consumes": [
    {
      "artifact": "game-profile",
      "required": true,
      "schema": "spec/artifacts/game-profile.schema.json"
    },
    {
      "artifact": "evidence-pack",
      "required": true,
      "schema": "spec/artifacts/evidence-pack.schema.json"
    },
    {
      "artifact": "change-list",
      "required": false,
      "schema": "spec/artifacts/change-list.schema.json",
      "whenMissing": "Continue: build the change list from the repository history for the shipped range; without repository access, record NOT_RUN for patch notes."
    },
    {
      "artifact": "economy-change-list",
      "required": false,
      "schema": "spec/artifacts/economy-change-list.schema.json"
    },
    {
      "artifact": "balance-patch-draft",
      "required": false,
      "schema": "spec/artifacts/balance-patch-draft.schema.json"
    },
    {
      "artifact": "clip-list",
      "required": false,
      "schema": "spec/artifacts/clip-list.schema.json"
    },
    {
      "artifact": "media-export-manifest",
      "required": false,
      "schema": "spec/artifacts/media-export-manifest.schema.json"
    },
    {
      "artifact": "store-asset-manifest",
      "required": false,
      "schema": "spec/artifacts/store-asset-manifest.schema.json",
      "whenMissing": "Continue: outreach drafts leave out the press kit link and say so."
    },
    {
      "artifact": "fairness-findings",
      "required": false,
      "schema": "spec/artifacts/fairness-findings.schema.json"
    },
    {
      "artifact": "work-plan",
      "required": false,
      "schema": "spec/artifacts/work-plan.schema.json"
    }
  ],
  "memory": {
    "reads": [
      "decisions",
      "releases",
      "balance"
    ],
    "writes": [
      "decisions",
      "releases"
    ]
  }
}
