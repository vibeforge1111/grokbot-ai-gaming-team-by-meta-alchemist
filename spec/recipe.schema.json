{
  "$id": "grokbot-template-kit/recipe.schema.json",
  "title": "Grok Bot template recipe (recipe.json)",
  "type": "object",
  "required": ["version", "visibility", "profile", "gettingStarted", "skills", "memory", "routines", "plugins"],
  "properties": {
    "version": { "const": 1 },
    "visibility": { "enum": ["public", "private"] },
    "profile": {
      "type": "object",
      "required": ["name", "description", "avatarShape", "avatarColor"],
      "properties": { "name": { "type": "string", "minLength": 3 }, "description": { "type": "string", "minLength": 40 } }
    },
    "gettingStarted": { "type": "object", "required": ["skill"] },
    "skills": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["name", "description", "content"], "properties": { "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, "description": { "type": "string", "minLength": 20 }, "content": { "type": "string", "minLength": 200 } } } },
    "memory": { "type": "array", "minItems": 3, "maxItems": 12, "items": { "type": "object", "required": ["kind", "content"] } },
    "routines": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["slug", "name", "description", "content"] } },
    "plugins": { "type": "array" }
  }
}
