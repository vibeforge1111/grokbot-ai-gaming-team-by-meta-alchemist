{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/economy-change-list.schema.json",
  "title": "Economy change list (team artifact)",
  "description": "Proposed changes to resources, rewards, prices or timings with simulation results from Economy Director. Proposals only. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "economy-change-list"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One proposed change.",
      "items": {
        "type": "object",
        "required": [
          "parameter",
          "from",
          "to",
          "reason"
        ],
        "properties": {
          "parameter": {
            "type": "string",
            "description": "Config key or rule."
          },
          "from": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "description": "Current value."
          },
          "to": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "description": "Proposed value."
          },
          "reason": {
            "type": "string",
            "description": "Why, citing evidence."
          },
          "simulation": {
            "type": "object",
            "description": "seed, runs and result summary, or NOT_RUN."
          },
          "touchesPayments": {
            "type": "boolean",
            "description": "True when the change affects paid items; Live Service Trust must review it."
          }
        }
      }
    }
  }
}
