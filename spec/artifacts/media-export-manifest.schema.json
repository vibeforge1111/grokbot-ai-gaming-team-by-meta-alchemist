{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/media-export-manifest.schema.json",
  "title": "Media export manifest (team artifact)",
  "description": "Final cuts and stills with formats and the redaction review from Trailer Director. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "media-export-manifest"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One exported file.",
      "items": {
        "type": "object",
        "required": [
          "path",
          "format",
          "sha256",
          "redactionReviewed"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative file path."
          },
          "format": {
            "type": "string",
            "description": "Container and aspect, for example mp4 16:9."
          },
          "durationS": {
            "type": "number",
            "description": "Duration in seconds."
          },
          "sha256": {
            "type": "string",
            "description": "Hex digest."
          },
          "redactionReviewed": {
            "type": "boolean",
            "description": "True once a human reviewed it for private information."
          }
        }
      }
    }
  }
}
