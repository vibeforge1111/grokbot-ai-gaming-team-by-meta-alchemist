{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/incident-report.schema.json",
  "title": "Incident report (team artifact)",
  "description": "Outage, save loss, entitlement or payment incident summaries from Live Service Trust. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "incident-report"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One incident.",
      "items": {
        "type": "object",
        "required": [
          "incidentId",
          "impact",
          "status"
        ],
        "properties": {
          "incidentId": {
            "type": "string",
            "description": "Local incident id."
          },
          "started": {
            "type": "string",
            "description": "UTC start time."
          },
          "ended": {
            "type": "string",
            "description": "UTC end time, when resolved."
          },
          "impact": {
            "type": "string",
            "description": "What players lost or could not do."
          },
          "cause": {
            "type": "string",
            "description": "Root cause, when known."
          },
          "status": {
            "type": "string",
            "description": "open, mitigated or resolved.",
            "enum": [
              "open",
              "mitigated",
              "resolved"
            ]
          }
        }
      }
    }
  }
}
