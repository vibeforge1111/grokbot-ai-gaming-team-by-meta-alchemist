{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/clip-list.schema.json",
  "title": "Clip list (team artifact)",
  "description": "Ranked gameplay moments with build, timecode and rights from Trailer Director. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "clip-list"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One clip.",
      "items": {
        "type": "object",
        "required": [
          "clipId",
          "source",
          "start",
          "end",
          "reason"
        ],
        "properties": {
          "clipId": {
            "type": "string",
            "description": "Clip id."
          },
          "source": {
            "type": "string",
            "description": "Recording file or capture id."
          },
          "build": {
            "type": "string",
            "description": "Build id the footage shows."
          },
          "start": {
            "type": "number",
            "description": "Start in seconds."
          },
          "end": {
            "type": "number",
            "description": "End in seconds."
          },
          "reason": {
            "type": "string",
            "description": "Why this moment shows the game well."
          },
          "rights": {
            "type": "string",
            "description": "Rights status: owned, licensed, cleared or needs review."
          }
        }
      }
    }
  }
}
