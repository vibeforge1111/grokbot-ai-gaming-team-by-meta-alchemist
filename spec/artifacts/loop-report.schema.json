{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/loop-report.schema.json",
  "title": "Loop report (team artifact)",
  "description": "Core loop map, pacing diagnosis and experiment card from Game Loop Alchemist. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "loop-report"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One finding or experiment.",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "finding"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "loop-map, pacing or experiment."
          },
          "finding": {
            "type": "string",
            "description": "What was observed or proposed."
          },
          "lineId": {
            "type": "string",
            "description": "Rubric line id."
          },
          "packId": {
            "type": "string",
            "description": "Pack id."
          },
          "forTemplate": {
            "type": "string",
            "description": "Who should act on it, for example 09, 13, 01 or 06."
          }
        }
      }
    }
  }
}
