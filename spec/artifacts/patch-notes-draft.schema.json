{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/patch-notes-draft.schema.json",
  "title": "Patch notes draft (team artifact)",
  "description": "Player-facing notes for a release from Streamer and Patch Notes. A draft until a human publishes it. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "patch-notes-draft"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One note.",
      "items": {
        "type": "object",
        "required": [
          "section",
          "text",
          "changeRefs",
          "status"
        ],
        "properties": {
          "section": {
            "type": "string",
            "description": "Section heading."
          },
          "text": {
            "type": "string",
            "description": "Player-facing text."
          },
          "changeRefs": {
            "type": "array",
            "description": "Entries in the change-list this note describes.",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "description": "Always draft.",
            "enum": [
              "draft"
            ]
          }
        }
      }
    }
  }
}
