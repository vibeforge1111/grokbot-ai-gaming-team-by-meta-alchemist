{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/atlas-manifest.schema.json",
  "title": "Atlas manifest (team artifact)",
  "description": "Packed atlas frames, pivots and collision boxes from Sprite and Hitbox. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "atlas-manifest"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One frame.",
      "items": {
        "type": "object",
        "required": [
          "frame",
          "atlas",
          "rect"
        ],
        "properties": {
          "frame": {
            "type": "string",
            "description": "Frame id."
          },
          "atlas": {
            "type": "string",
            "description": "Atlas file."
          },
          "rect": {
            "type": "object",
            "description": "x, y, w, h in pixels."
          },
          "pivot": {
            "type": "object",
            "description": "Pivot x and y."
          },
          "boxes": {
            "type": "array",
            "description": "Collision, hurt or click boxes for this frame.",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
