{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/lobby-fill-proposal.schema.json",
  "title": "Lobby fill proposal (team artifact)",
  "description": "Queue fill, wait time and bot share findings with proposals for thin regions or queues, from the Matchmaking preview. Proposals only. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "lobby-fill-proposal"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One region or queue.",
      "items": {
        "type": "object",
        "required": [
          "region",
          "finding"
        ],
        "properties": {
          "region": {
            "type": "string",
            "description": "Region or queue code."
          },
          "humansPerHour": {
            "type": "number",
            "description": "Observed humans per hour."
          },
          "waitP90S": {
            "type": "number",
            "description": "p90 wait in seconds."
          },
          "botShare": {
            "type": "number",
            "description": "Share of seats filled by bots, 0 to 1."
          },
          "finding": {
            "type": "string",
            "description": "What to change, as a proposal."
          }
        }
      }
    }
  }
}
