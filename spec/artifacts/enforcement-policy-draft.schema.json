{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/enforcement-policy-draft.schema.json",
  "title": "Enforcement policy draft (team artifact)",
  "description": "Proposed review queues and sanction rules from the Fairness and Bridge template. A human decides every sanction. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "enforcement-policy-draft"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One rule.",
      "items": {
        "type": "object",
        "required": [
          "signal",
          "reviewStep",
          "decidedBy"
        ],
        "properties": {
          "signal": {
            "type": "string",
            "description": "What raises a case for review."
          },
          "reviewStep": {
            "type": "string",
            "description": "What the human reviewer checks."
          },
          "decidedBy": {
            "type": "string",
            "description": "Always human.",
            "enum": [
              "human"
            ]
          },
          "appealPath": {
            "type": "string",
            "description": "How a player appeals."
          }
        }
      }
    }
  }
}
