{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/layout-brief.schema.json",
  "title": "Layout brief (team artifact)",
  "description": "Spaces, routes, landmarks and asset requests from Environment Design. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "layout-brief"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One space or route.",
      "items": {
        "type": "object",
        "required": [
          "space",
          "purpose"
        ],
        "properties": {
          "space": {
            "type": "string",
            "description": "Level, room, screen or area id."
          },
          "purpose": {
            "type": "string",
            "description": "What the player does there."
          },
          "routes": {
            "type": "array",
            "description": "Routes or paths through it.",
            "items": {
              "type": "string"
            }
          },
          "landmarks": {
            "type": "array",
            "description": "Landmarks players use to navigate.",
            "items": {
              "type": "string"
            }
          },
          "assetRequests": {
            "type": "array",
            "description": "Props or tiles needed from Prop and Rig or Sprite and Hitbox.",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
