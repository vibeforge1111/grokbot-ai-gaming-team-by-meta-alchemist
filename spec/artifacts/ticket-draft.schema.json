{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/ticket-draft.schema.json",
  "title": "Ticket draft (team artifact)",
  "description": "A local issue draft for the human to review and file. Never filed automatically. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "ticket-draft"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One draft.",
      "items": {
        "type": "object",
        "required": [
          "title",
          "severity",
          "confidence",
          "sourceTemplate",
          "evidenceIds",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Short title."
          },
          "severity": {
            "type": "string",
            "description": "Severity from the owner's scale, for example P0 to P3."
          },
          "confidence": {
            "type": "string",
            "description": "How sure: confirmed, likely or unconfirmed."
          },
          "sourceTemplate": {
            "type": "string",
            "description": "Template id that found it."
          },
          "lineId": {
            "type": "string",
            "description": "Rubric line id, when there is one."
          },
          "packId": {
            "type": "string",
            "description": "Pack id."
          },
          "evidenceIds": {
            "type": "array",
            "description": "Artifact ids in the pack that show the problem.",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "description": "Always draft until a human files it.",
            "enum": [
              "draft"
            ]
          }
        }
      }
    }
  }
}
