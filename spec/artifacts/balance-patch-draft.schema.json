{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/balance-patch-draft.schema.json",
  "title": "Balance patch draft (team artifact)",
  "description": "Proposed tuning changes with rollback, alternatives and follow-up, from the Balance Patch preview. Proposals only. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "balance-patch-draft"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One parameter.",
      "items": {
        "type": "object",
        "required": [
          "parameter",
          "from",
          "to",
          "rollback"
        ],
        "properties": {
          "parameter": {
            "type": "string",
            "description": "Config key."
          },
          "from": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "description": "Current value."
          },
          "to": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "description": "Proposed value."
          },
          "rollback": {
            "type": "string",
            "description": "How to undo it."
          },
          "followUp": {
            "type": "string",
            "description": "What to measure after release."
          }
        }
      }
    }
  }
}
