{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/feel-findings.schema.json",
  "title": "Feel findings (team artifact)",
  "description": "Input-to-feedback findings per player action and device from Game Feel. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "feel-findings"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One action on one device.",
      "items": {
        "type": "object",
        "required": [
          "action",
          "device",
          "finding",
          "packId"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "The player action, for example jump, place tile, brake, open menu."
          },
          "device": {
            "type": "string",
            "description": "Input device or platform."
          },
          "latencyP95Ms": {
            "type": "number",
            "description": "Measured p95 input-to-feedback time, when measured."
          },
          "channels": {
            "type": "array",
            "description": "Feedback channels seen: visual, audio, haptic, camera.",
            "items": {
              "type": "string"
            }
          },
          "finding": {
            "type": "string",
            "description": "What to change or keep."
          },
          "lineId": {
            "type": "string",
            "description": "Rubric line id."
          },
          "packId": {
            "type": "string",
            "description": "Pack id."
          }
        }
      }
    }
  }
}
