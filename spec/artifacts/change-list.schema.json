{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/change-list.schema.json",
  "title": "Change list (team artifact)",
  "description": "Verified changes between two builds, from the owner's repository or Bug Desk closures. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "change-list"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One change.",
      "items": {
        "type": "object",
        "required": [
          "change",
          "buildFrom",
          "buildTo",
          "verified"
        ],
        "properties": {
          "change": {
            "type": "string",
            "description": "Plain description of the change."
          },
          "area": {
            "type": "string",
            "description": "Game area."
          },
          "buildFrom": {
            "type": "string",
            "description": "Old build id."
          },
          "buildTo": {
            "type": "string",
            "description": "New build id."
          },
          "verified": {
            "type": "boolean",
            "description": "True when a check confirmed it in the new build."
          },
          "ticket": {
            "type": "string",
            "description": "Local ticket draft or tracker reference."
          }
        }
      }
    }
  }
}
