{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/cohort-report.schema.json",
  "title": "Cohort report (team artifact)",
  "description": "Retention by cohort and segment with intervals and small-cell suppression, from the Retention preview. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "cohort-report"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One cohort and segment.",
      "items": {
        "type": "object",
        "required": [
          "cohort",
          "segment",
          "day",
          "rate"
        ],
        "properties": {
          "cohort": {
            "type": "string",
            "description": "Cohort label, for example a week."
          },
          "segment": {
            "type": "string",
            "description": "Approved segment."
          },
          "day": {
            "type": "number",
            "description": "Day since first session."
          },
          "rate": {
            "type": "number",
            "description": "Retention rate, 0 to 1."
          },
          "interval": {
            "type": "array",
            "description": "Lower and upper bound.",
            "items": {
              "type": "number"
            }
          },
          "suppressed": {
            "type": "boolean",
            "description": "True when the cell is below the minimum size."
          }
        }
      }
    }
  }
}
