{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/hud-capture-set.schema.json",
  "title": "HUD capture set (team artifact)",
  "description": "Screenshots and UI traces per device, viewport and UI state from HUD Designer. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "hud-capture-set"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One capture.",
      "items": {
        "type": "object",
        "required": [
          "device",
          "viewport",
          "state",
          "path",
          "sha256"
        ],
        "properties": {
          "device": {
            "type": "string",
            "description": "Device."
          },
          "viewport": {
            "type": "string",
            "description": "Viewport or resolution."
          },
          "state": {
            "type": "string",
            "description": "UI state, for example first session, pause menu, inventory, results."
          },
          "path": {
            "type": "string",
            "description": "Relative file path."
          },
          "sha256": {
            "type": "string",
            "description": "Hex digest of the file."
          },
          "locale": {
            "type": "string",
            "description": "Locale shown, when relevant."
          }
        }
      }
    }
  }
}
