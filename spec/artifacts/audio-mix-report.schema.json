{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grokbot-template-kit/artifacts/audio-mix-report.schema.json",
  "title": "Audio mix report (team artifact)",
  "description": "Loudness, bus, ducking and caption timing results from Audio Director. Created by @meta_alchemist (https://x.com/meta_alchemist).",
  "x-version": "1.0.0",
  "type": "object",
  "required": [
    "artifact",
    "version",
    "producer",
    "createdAt",
    "synthetic",
    "items"
  ],
  "properties": {
    "artifact": {
      "const": "audio-mix-report"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Artifact schema version the producer wrote. Same major as x-version."
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Template id, or owner for files the owner makes."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the file was written."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True for worked examples. Consumers never treat synthetic data as a measurement."
    },
    "build": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "liveSha": {
          "type": "string"
        }
      },
      "description": "The build the items describe, when they describe one."
    },
    "items": {
      "type": "array",
      "description": "One measured audio item.",
      "items": {
        "type": "object",
        "required": [
          "item",
          "measure",
          "value",
          "target"
        ],
        "properties": {
          "item": {
            "type": "string",
            "description": "Event, bus, stem or caption track."
          },
          "measure": {
            "type": "string",
            "description": "What was measured, for example integrated loudness or caption offset."
          },
          "value": {
            "type": "number",
            "description": "Measured value."
          },
          "target": {
            "type": "number",
            "description": "Profile target."
          },
          "unit": {
            "type": "string",
            "description": "Unit, for example LUFS or ms."
          },
          "finding": {
            "type": "string",
            "description": "What to change or keep."
          }
        }
      }
    }
  }
}
