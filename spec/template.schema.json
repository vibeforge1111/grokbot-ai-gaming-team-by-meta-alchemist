{
  "$id": "grokbot-template-kit/template.schema.json",
  "title": "Kit template manifest (template.json)",
  "type": "object",
  "required": [
    "kitVersion",
    "id",
    "slug",
    "name",
    "summary",
    "stage",
    "credit",
    "creditUrl",
    "install",
    "gettingStarted",
    "skills",
    "routines",
    "rubric",
    "engine",
    "version",
    "status",
    "teamSpec",
    "compat",
    "produces",
    "consumes",
    "memory"
  ],
  "properties": {
    "kitVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+-[0-9]{2}-[a-z0-9-]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "stage": {
      "type": "string",
      "minLength": 3
    },
    "credit": {
      "const": "@meta_alchemist"
    },
    "creditUrl": {
      "const": "https://x.com/meta_alchemist"
    },
    "install": {
      "type": "object",
      "required": [
        "grokBotShareLink",
        "shareLinkStatus"
      ],
      "properties": {
        "grokBotShareLink": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:pending review|grokbot://app/v1/bot-template\\?id=[A-Za-z0-9_-]+)$"
        },
        "shareLinkStatus": {
          "enum": [
            "pending review",
            "live"
          ]
        }
      }
    },
    "gettingStarted": {
      "type": "string",
      "pattern": "-getting-started$"
    },
    "skills": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "routines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rubric": {
      "type": "object",
      "required": [
        "path",
        "id",
        "version",
        "hash"
      ],
      "properties": {
        "path": {
          "const": "RUBRIC.json"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "engine": {
      "type": "object",
      "required": [
        "cmd",
        "goodPack"
      ]
    },
    "shortName": {
      "type": "string",
      "minLength": 2
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": [
        "shipping",
        "preview"
      ]
    },
    "teamSpec": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "compat": {
      "type": "object",
      "required": [
        "teamSpec",
        "consumes"
      ],
      "properties": {
        "teamSpec": {
          "type": "string",
          "minLength": 1
        },
        "consumes": {
          "type": "object"
        }
      }
    },
    "produces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact",
          "version",
          "format",
          "schema"
        ],
        "properties": {
          "artifact": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
          },
          "format": {
            "type": "string",
            "minLength": 3
          },
          "schema": {
            "type": "string",
            "pattern": "^spec/artifacts/[a-z0-9-]+\\.schema\\.json$"
          }
        }
      }
    },
    "consumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact",
          "required",
          "schema"
        ],
        "properties": {
          "artifact": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "required": {
            "type": "boolean"
          },
          "schema": {
            "type": "string",
            "pattern": "^spec/artifacts/[a-z0-9-]+\\.schema\\.json$"
          },
          "whenMissing": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "required": [
        "reads",
        "writes"
      ],
      "properties": {
        "reads": {
          "type": "array",
          "items": {
            "enum": [
              "decisions",
              "incidents",
              "entitlements",
              "balance",
              "regions",
              "releases"
            ]
          }
        },
        "writes": {
          "type": "array",
          "items": {
            "enum": [
              "decisions",
              "incidents",
              "entitlements",
              "balance",
              "regions",
              "releases"
            ]
          }
        }
      }
    }
  }
}
